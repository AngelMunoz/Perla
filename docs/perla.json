{
  "$schema": "../perla.schema.json",
  "schema-version": "2025-07",
  "provider": "jspm",
  "plugins": [
    "perla-esbuild-plugin",
    "markdown-plugin"
  ],
  "useLocalPkgs": true,
  "mountDirectories": {
    "/": "./sw",
    "/assets": "./assets",
    "/src": "./src"
  },
  "esbuild": {
    "jsxAutomatic": true,
    "jsxImportSource": "preact"
  },
  "dependencies": {
    "@preact/signals": "2.2.1",
    "@preact/signals-core": "1.11.0",
    "@shoelace-style/shoelace": "2.20.1",
    "@shoelace-style/shoelace/dist/utilities/base-path.js": "2.20.1",
    "composed-offset-position": "0.0.6",
    "highlight.js": "11.11.1",
    "highlight.js/lib/core": "11.11.1",
    "highlight.js/lib/languages/bash": "11.11.1",
    "highlight.js/lib/languages/diff": "11.11.1",
    "highlight.js/lib/languages/fsharp": "11.11.1",
    "highlight.js/lib/languages/javascript": "11.11.1",
    "highlight.js/lib/languages/json": "11.11.1",
    "highlight.js/lib/languages/plaintext": "11.11.1",
    "highlight.js/lib/languages/xml": "11.11.1",
    "lit": "3.3.1",
    "lit-element": "4.2.1",
    "lit-html": "3.3.1",
    "navigo": "8.11.1",
    "preact": "10.26.9",
    "preact/hooks": "10.26.9",
    "preact/jsx-runtime": "10.26.9",
    "qr-creator": "1.0.0"
  }
}