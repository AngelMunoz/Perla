{
  "$schema": "https://raw.githubusercontent.com/AngelMunoz/Perla/dev/perla.templates.schema.json",
  "name": "Perla Templates",
  "description": "Official Perla template starters",
  "author": "Perla",
  "license": "MIT",
  "repository": "https://github.com/AngelMunoz/perla-templates",
  "group": "perla.templates",
  "templates": [
    {
      "id": "basic",
      "name": "Basic Template",
      "shortname": "basic",
      "path": "./basic",
      "description": "Just perla.json and index.html, nothing more, nothing less."
    },
    {
      "id": "blocal",
      "name": "Basic Local Template",
      "shortname": "blocal",
      "path": "./blocal",
      "description": "Just perla.json and index.html, configured to use local dependencies."
    },
    {
      "id": "fable.empty",
      "name": "Empty Fable",
      "shortname": "fempty",
      "path": "./fable-empty",
      "description": "The Fable Compiler + Perla"
    },
    {
      "id": "fable.feliz",
      "name": "Fable Feliz",
      "shortname": "feliz",
      "path": "./fable-feliz",
      "description": "Fable Compiler + Feliz React SPA template"
    },
    {
      "id": "jsx.empty",
      "name": "Empty JSX",
      "shortname": "jsx",
      "path": "./empty-jsx",
      "description": "An Empty JSX template"
    }
  ]
}
