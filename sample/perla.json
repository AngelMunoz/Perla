{
  "$schema": "../perla.schema.json",
  "schema-version": "2025-07",
  "fable": {
    "project": "./src/App.fsproj",
    "extension": ".js",
    "outDir": "./fable_output"
  },
  "plugins": ["perla-esbuild-plugin"],
  "paths": {
    "@nested/": "./src/nested1/nested2/"
  },
  "mountDirectories": {
    "/src": "./src",
    "/fable_output": "./fable_output",
    "/assets": "./assets"
  },
  "build": {
    "includes": ["assets/favicon.ico", "assets/manifest.webmanifest"]
  },
  "testing": {
    "fable": {
      "project": "./tests/App.Tests.fsproj"
    }
  },
  "dependencies": {
    "@lit/reactive-element": "1.6.3",
    "fsharp-components": "0.0.4",
    "lit": "2.4.0",
    "lit-element": "3.3.3",
    "lit-element/lit-element.js": "3.3.3",
    "lit-html": "2.8.0"
  },
  "useLocalPkgs": true
}
