{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "moduleResolution": "bundler",
    "module": "esnext",
    "isolatedModules": true,
    "lib": ["DOM", "ES2020"],
    "erasableSyntaxOnly": true,
    "paths": {
      "@nested/*": ["./src/nested1/nested2/*"]
    }
  },
  "exclude": ["node_modules"],
  "include": ["src/**/*.js"],
  "typeAcquisition": {
    "enable": true,
    "include": ["lit", "fsharp-components"]
  }
}
